# Copy to .env for docker compose / local runs. No secrets are needed by default.

# --- API (credit_default.serve) ---
MODEL_SOURCE=auto                 # auto | registry | local
MODEL_URI=models:/credit-default@production
MODEL_BUNDLE_PATH=models/bundled/model.joblib
# MLFLOW_TRACKING_URI=http://localhost:5000   # unset: serve the bundled model
PREDICTION_LOG_ENABLED=true
PREDICTION_LOG_PATH=logs/predictions.sqlite
RATE_LIMIT_PER_MINUTE=120         # per client IP; 0 disables (load tests)
MAX_BODY_BYTES=2000000            # 413 above this
CORS_ORIGINS=https://srini2k03.github.io   # comma-separated; the dashboard calls the API
FAST_SCORING=true                 # NumPy scoring path, enabled only if bit-identical
EXPLAINER_WARMUP=true             # build the SHAP explainer at startup
LOG_FORMAT=json                   # json | text
LOG_LEVEL=INFO

# --- tooling ---
MLFLOW_DISABLE_TELEMETRY=true
DO_NOT_TRACK=1
